{
  "name": "@javadaba/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Javadaba's design system: the surface contract (--jd-*), scales, the ecosystem's typography and pieces. Mandatory in packages/apps/*, opt-in outside. See doc://contracts/design-system.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.native.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./tokens.css",
    "./next": "./next/with-component-stamps.mjs",
    "./fonts": {
      "types": "./src/fonts.ts",
      "default": "./src/fonts.ts"
    },
    "./lib/cn": {
      "types": "./src/lib/cn.ts",
      "default": "./src/lib/cn.ts"
    },
    "./shortcuts": {
      "types": "./src/lib/shortcuts.ts",
      "default": "./src/lib/shortcuts.ts"
    },
    "./view-transition": {
      "types": "./src/lib/view-transition.ts",
      "default": "./src/lib/view-transition.ts"
    },
    "./hooks": {
      "types": "./src/hooks/index.ts",
      "default": "./src/hooks/index.ts"
    },
    "./feedback": {
      "types": "./src/feedback/index.ts",
      "default": "./src/feedback/index.ts"
    },
    "./navigation": {
      "types": "./src/navigation/index.tsx",
      "react-native": "./src/navigation/index.native.tsx",
      "default": "./src/navigation/index.tsx"
    },
    "./navigation/paths": {
      "types": "./src/navigation/paths.ts",
      "default": "./src/navigation/paths.ts"
    },
    "./not-on-android": {
      "types": "./src/not-on-android.ts",
      "default": "./src/not-on-android.ts"
    },
    "./text": {
      "types": "./src/ui/text.tsx",
      "react-native": "./src/ui/text.native.tsx",
      "default": "./src/ui/text.tsx"
    },
    "./qr": {
      "types": "./src/qr/index.ts",
      "default": "./src/qr/index.ts"
    },
    "./calendar": {
      "types": "./src/calendar/index.ts",
      "react-native": "./src/calendar/index.native.ts",
      "default": "./src/calendar/index.ts"
    },
    "./motion": {
      "react-native": "./src/motion/index.native.ts",
      "types": "./src/motion/index.ts",
      "default": "./src/motion/index.ts"
    },
    "./canvas": {
      "types": "./src/canvas/index.ts",
      "default": "./src/canvas/index.ts"
    },
    "./native-twins": {
      "types": "./src/native-twins.ts",
      "default": "./src/native-twins.ts"
    },
    "./tour": {
      "types": "./src/tour/index.ts",
      "default": "./src/tour/index.ts"
    },
    "./kid": {
      "types": "./src/kid/index.ts",
      "default": "./src/kid/index.ts"
    },
    "./canvas/theme/*": "./src/canvas/theme/*"
  },
  "files": [
    "src",
    "tokens.css"
  ],
  "scripts": {
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "dev:canvas": "vite --config playground/canvas/vite.config.ts --port 3012",
    "dev:toast": "vite --config playground/toast/vite.config.ts --port 3013 --strictPort",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@javadaba/brand": "workspace:*",
    "@javadaba/sdk": "workspace:*",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-separator": "catalog:",
    "@radix-ui/react-slider": "^1.5.0",
    "@radix-ui/react-slot": "catalog:",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-toggle": "^1.1.19",
    "@radix-ui/react-toggle-group": "^1.1.20",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "qrcode": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@javadaba/e2e-kit": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/qrcode": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
