{
  "name": "@javadaba/rich-text",
  "version": "0.1.0",
  "private": true,
  "description": "The ecosystem's rich-text engine: Fabula's TipTap editor and its toolbar controls, extracted so any app can edit and render formatted text. Markdown in, Markdown out when the app stores Markdown (Officium); ProseMirror JSON when it stores documents (Fabula).",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./rich-text.css": "./src/rich-text.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@javadaba/ui": "workspace:*",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-character-count": "catalog:",
    "@tiptap/extension-code-block": "catalog:",
    "@tiptap/extension-collaboration": "catalog:",
    "@tiptap/extension-collaboration-caret": "catalog:",
    "@tiptap/extension-color": "catalog:",
    "@tiptap/extension-highlight": "catalog:",
    "@tiptap/extension-horizontal-rule": "catalog:",
    "@tiptap/extension-image": "catalog:",
    "@tiptap/extension-link": "catalog:",
    "@tiptap/extension-placeholder": "catalog:",
    "@tiptap/extension-subscript": "catalog:",
    "@tiptap/extension-superscript": "catalog:",
    "@tiptap/extension-table": "catalog:",
    "@tiptap/extension-table-cell": "catalog:",
    "@tiptap/extension-table-header": "catalog:",
    "@tiptap/extension-table-row": "catalog:",
    "@tiptap/extension-task-item": "catalog:",
    "@tiptap/extension-task-list": "catalog:",
    "@tiptap/extension-text-align": "catalog:",
    "@tiptap/extension-text-style": "catalog:",
    "@tiptap/extension-typography": "catalog:",
    "@tiptap/extension-underline": "catalog:",
    "@tiptap/markdown": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/react": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@tiptap/static-renderer": "catalog:",
    "@tiptap/suggestion": "catalog:",
    "@tiptap/y-tiptap": "catalog:",
    "lucide-react": "catalog:",
    "mermaid": "catalog:",
    "y-protocols": "catalog:",
    "yjs": "catalog:"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
