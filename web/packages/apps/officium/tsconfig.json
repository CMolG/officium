{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-gate/types/**/*.ts",
    ".next-gate/dev/types/**/*.ts"
  ],
  // The sync spec imports from javadaba-landing, which is not in this app's Docker build context
  // (ops/prod/Dockerfile.miniapp copies only packages/apps/officium), so `next build`'s typecheck
  // would fail on it in production. Playwright compiles and runs it on its own, from the checkout.
  "exclude": [
    "node_modules",
    "edition-local",
    "e2e/mcp-clients-sync.spec.ts"
  ]
}
