<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.javadaba</groupId>
        <artifactId>javadaba-api</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>
    <artifactId>officium-infrastructure</artifactId>
    <dependencies>
        <dependency>
            <groupId>com.javadaba</groupId>
            <artifactId>officium-application</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <!-- JAVA-50: the sweep that closes the agent runs nobody ended. Same placement rule as
             notify's DeliveryRetryScheduler: the scheduler lives only in the context's
             infrastructure, the logic in a plain service (AgentRunService#sweep). -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-scheduler</artifactId>
        </dependency>
        <!-- JAVA-476: every scheduled job runs once per slot across app-api instances. -->
        <dependency>
            <groupId>com.javadaba</groupId>
            <artifactId>platform-scheduling</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Busqueda-tarjetas-officium (fila aprobada en .harness/PREFERRED_TECHNOLOGIES.csv):
             backend de produccion de cards.search desde 2026-09-20, tras el benchmark de
             2026-09-19 (doc://history/plans/2026-09-19-officium-busqueda-backends-benchmark). -->
        <dependency>
            <groupId>org.roaringbitmap</groupId>
            <artifactId>RoaringBitmap</artifactId>
            <version>1.3.0</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
